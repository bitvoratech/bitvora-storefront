# Copy to .env.local. The marketing site is a static export, so this is baked in at build time.

# Where "Sign up" / "Log in" links point. Defaults to https://app.bitvoratech.com.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# This site's public URL, for the sitemap, robots.txt and share images. Defaults to https://stores.bitvoratech.com.
NEXT_PUBLIC_SITE_URL=

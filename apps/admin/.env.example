# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for owner tools and privileged writes (OTP, verification).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (product, hero and avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (rate limiting). OTP and identity checks fail closed without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Termii (phone OTP SMS)
TERMII_API_KEY=
TERMII_SENDER_ID=

# QoreID (NIN / CAC identity verification)
QOREID_CLIENT_ID=
QOREID_SECRET_KEY=

# Public storefront base URL, used for store links, QR codes and share images.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001

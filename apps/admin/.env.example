# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for owner tools and privileged writes (signup details, OTP, verification).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (product, hero and avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (rate limiting). OTP and identity checks fail closed without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Termii (phone OTP SMS). The sender ID must be approved in the Termii dashboard.
TERMII_API_KEY=
TERMII_SENDER_ID=
# Optional: your account's base URL from the Termii dashboard (default https://v3.api.termii.com)
TERMII_BASE_URL=
# Optional: 'dnd' (default, reaches Do-Not-Disturb numbers; needs the DND route on your account) or 'generic'
TERMII_CHANNEL=


# Public storefront base URL, used for store links, QR codes and share images.
# Production: https://shop.bitvoratech.com (stores live at /<store-slug>).
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001

# Marketing site, for the Terms and Privacy links on signup. Defaults to https://stores.bitvoratech.com.
NEXT_PUBLIC_WEBSITE_URL=

# Optional: beta feedback form link (e.g. Tally). Shows "Send feedback" in the sidebar when set.
NEXT_PUBLIC_FEEDBACK_URL=

# Paystack, for merchants paying for their plan (not storefront checkout).
# Secret key from Paystack → Settings → API Keys & Webhooks. Set the webhook URL
# there to https://app.bitvoratech.com/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Optional: percent off the first month of a monthly plan for merchants who pay
# while it is set (e.g. 50 for the closed beta). Renewals are full price.
PLAN_DISCOUNT_PERCENT=

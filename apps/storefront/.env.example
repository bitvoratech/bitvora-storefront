# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by checkout, payment-proof and restock server actions.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (payment-proof uploads; must be the same account as the admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (rate limiting on checkout, uploads and public APIs)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# This app's public URL, used for link previews. Production: https://shop.bitvoratech.com
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001
